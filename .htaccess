# ═══════════════════════════════════════════════════════════════════════════
#  FluentFox — конфігурація Apache / LiteSpeed (Hostinger)
#  Порядок блоків має значення: спершу редиректи, потім помилки, потім кеш.
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Канонічний хост і адреси ────────────────────────────────────────────
# www-версія віддавала 200 з тим самим вмістом, тобто кожна сторінка сайту
# існувала для Google у двох екземплярах. rel=canonical це лише підказка —
# 301 прибирає дубль остаточно. http→https Hostinger робить сам, тому цього
# правила тут немає: друге таке ж правило за проксі здатне зациклитись.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.fluent-fox.site → fluent-fox.site
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ── Посадкові сторінки без .html ────────────────────────────────────────
  # Адреса /tsiny читається людиною і не розсипається при копіюванні в чат.
  # Спершу 301 з .html-варіанта — інакше та сама сторінка існувала б за двома
  # адресами одразу, тобто рівно той дубль, заради якого вище стоїть 301 з www.
  RewriteCond %{THE_REQUEST} \s/+(anhliyska-6-8-rokiv|anhliyska-9-12-rokiv|anhliyska-13-18-rokiv|pidhotovka-do-nmt|cambridge|tsiny|vidhuky|pro-shkolu|probnyi-urok|dnipro|kursy-anhliyskoyi-dlya-ditey|anhliyska-onlayn-dlya-ditey|repetytor-z-anhliyskoyi|rozmovna-anhliyska-dlya-ditey)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # І лише потім внутрішнє переписування на реальний файл.
  RewriteRule ^(anhliyska-6-8-rokiv|anhliyska-9-12-rokiv|anhliyska-13-18-rokiv|pidhotovka-do-nmt|cambridge|tsiny|vidhuky|pro-shkolu|probnyi-urok|dnipro|kursy-anhliyskoyi-dlya-ditey|anhliyska-onlayn-dlya-ditey|repetytor-z-anhliyskoyi|rozmovna-anhliyska-dlya-ditey)$ $1.html [L]

  # /index.html → /  (і /blog/index.html → /blog/)
  # Умова на THE_REQUEST важлива: вона дивиться на те, що написав клієнт, а не
  # на внутрішнє переписування DirectoryIndex — інакше «/» зациклиться сам на себе.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

# ── 2. Сторінки помилок ────────────────────────────────────────────────────
# Без цього рядка Hostinger віддає власну англомовну заглушку — чужий бренд
# на нашому домені і жодного шляху назад на сайт.
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 503 /503.html

# ── 3. Стиснення ───────────────────────────────────────────────────────────
# LiteSpeed вже віддає brotli для HTML; блок лишається як запобіжник на
# випадок переїзду на звичайний Apache.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 4. Кеш статики ─────────────────────────────────────────────────────────
# Картинки й шрифти в нас незмінні (ім'я файлу = вміст), тому рік.
# HTML — година: правки викочуються деплоєм і мають доїжджати швидко.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 1 hour"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/xml              "access plus 1 day"
  ExpiresByType text/plain            "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # ── 5. Політика вмісту ────────────────────────────────────────────────────
  # Раніше CSP тут не було: Tailwind приїжджав компілятором з CDN, і будь-яка
  # сувора політика ламала б сторінку мовчки. Після переходу на складений
  # css/style.css зовнішніх джерел лишилося рівно чотири, і їх можна перелічити.
  #
  # 'unsafe-eval' у script-src потрібен Alpine: вирази з x-text та @click він
  # компілює через new Function. Прибрати його можна лише переїздом на
  # CSP-збірку Alpine, а це переписування всіх виразів на сторінці.
  # 'unsafe-inline' — через вбудований сніпет GTM і скрипти в <head>.
  # Політика все одно робить головне: скрипт із чужого домену не завантажиться.
  #
  # script.google.com і script.googleusercontent.com — туди форма шле заявку
  # (fetch, mode: no-cors). Прибрати їх з connect-src означає мовчки зламати
  # запис на пробний урок; сам збій при no-cors навіть не видно в коді.
  #
  # УВАГА: нові теги в GTM (піксель Meta, Hotjar тощо) ця політика заблокує,
  # доки їхній домен не додано в script-src і connect-src.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://script.google.com https://script.googleusercontent.com; frame-src https://www.googletagmanager.com; frame-ancestors 'self'; form-action 'self' https://script.google.com; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# ── 6. MIME-типи ───────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType image/webp             .webp
  AddType application/ld+json    .jsonld
  AddType text/plain             .txt
</IfModule>

# ── 7. Закрити службові файли ──────────────────────────────────────────────
<IfModule mod_authz_core.c>
  <FilesMatch "^(\.htaccess|\.gitignore|.*\.md)$">
    Require all denied
  </FilesMatch>
</IfModule>
