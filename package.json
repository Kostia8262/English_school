{
  "name": "fluentfox-site",
  "private": true,
  "description": "Статичний сайт FluentFox. npm потрібен лише для складання CSS — у деплої його немає, css/style.css лежить у репозиторії.",
  "scripts": {
    "css": "tailwindcss -i ./src/tailwind.css -o ./css/style.css --minify",
    "css:watch": "tailwindcss -i ./src/tailwind.css -o ./css/style.css --watch",
    "logo": "node tools/icons/render-logo.js",
    "og": "node tools/og/build.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "3.4.17"
  }
}
